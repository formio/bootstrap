<div class="row">
  {% if (ctx.dayFirst && ctx.showDay) { %}
  <div class="form-group col col-xs-3">
    {% if (!ctx.component.hideInputLabels) { %}
    <label for="{{ctx.component.key}}-day">{{ctx.t('day')}}{% if (ctx.component.fields.day.required) { %}<span class="required-star" aria-hidden="true"> *</span>{% } %}</label>
    {% } %}
    <div>{{ctx.day}}</div>
  </div>
  {% } %}
  {% if (ctx.showMonth) { %}
  <div class="form-group col col-xs-4">
    {% if (!ctx.component.hideInputLabels) { %}
    <label for="{{ctx.component.key}}-month">{{ctx.t('month')}}{% if (ctx.component.fields.month.required) { %}<span class="required-star" aria-hidden="true"> *</span>{% } %}</label>
    {% } %}
    <div>{{ctx.month}}</div>
  </div>
  {% } %}
  {% if (!ctx.dayFirst && ctx.showDay) { %}
  <div class="form-group col col-xs-3">
    {% if (!ctx.component.hideInputLabels) { %}
    <label for="{{ctx.component.key}}-day">{{ctx.t('day')}}{% if (ctx.component.fields.day.required) { %}<span class="required-star" aria-hidden="true"> *</span>{% } %}</label>
    {% } %}
    <div>{{ctx.day}}</div>
  </div>
  {% } %}
  {% if (ctx.showYear) { %}
  <div class="form-group col col-xs-5">
    {% if (!ctx.component.hideInputLabels) { %}
    <label for="{{ctx.component.key}}-year">{{ctx.t('year')}}{% if (ctx.component.fields.year.required) { %}<span class="required-star" aria-hidden="true"> *</span>{% } %}</label>
    {% } %}
    <div>{{ctx.year}}</div>
  </div>
  {% } %}
</div>
<input name="data[day]" type="hidden" class="form-control" lang="en" value="" ref="input">
